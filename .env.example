# Create these values from Sapling's own Supabase project.
# Never copy Crumbs credentials or project identifiers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 1 keeps learners in the browser (no sign-in, local progress) while still
# saving and reusing the shared speech clips. The demo launch configs set it.
NEXT_PUBLIC_SAPLING_DEMO=

# Canonical URL used for metadata and authentication redirects.
# Local: http://localhost:3000
# Production: your Sapling custom domain
NEXT_PUBLIC_SAPLING_SITE_URL=http://localhost:3000

# Optional for local AI lesson feedback and natural neural voices (/api/speech).
# Without it, speech falls back to recorded clips and the browser's voice.
# Vercel deployments use OIDC automatically.
AI_GATEWAY_API_KEY=

# Server-only GPT-Live-1 key. Live voice stays unavailable until configured.
# Also speaks lines through OpenAI TTS when Gemini is unavailable.
OPENAI_LIVE_VOICE_KEY=

# Server-only, for `npm run speech:generate` to store clips from the command
# line (/dev/voices doesn't need it). Supabase → Project Settings → API keys.
SUPABASE_SECRET_KEY=
