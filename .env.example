# Create these values from Sapling's own Supabase project.
# Never copy Crumbs credentials or project identifiers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical URL used for metadata and authentication redirects.
# Local: http://localhost:3000
# Production: your Sapling custom domain
NEXT_PUBLIC_SAPLING_SITE_URL=http://localhost:3000

# Server-only Azure Speech credentials. Never prefix these with NEXT_PUBLIC_.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus2
