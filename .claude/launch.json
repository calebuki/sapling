{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sapling-demo-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start"
      ],
      "port": 3100,
      "autoPort": true,
      "env": {
        "NEXT_PUBLIC_SAPLING_DEMO": "1"
      }
    },
    {
      "name": "sapling-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "sapling-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true,
      "env": {
        "NEXT_PUBLIC_SAPLING_DEMO": "1"
      }
    },
    {
      "name": "sapling-dev-auto",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
